# Copy thành .env (cạnh docker-compose.yml) rồi điền. Không commit .env.

# --- Docker ---
# Mật khẩu SA của SQL Server: ≥ 8 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt; KHÔNG dùng dấu ; hoặc "
MSSQL_SA_PASSWORD=
# Domain của API (trỏ A record về IP VPS), dùng khi bật profile https
API_DOMAIN=api.example.com
# Cổng API trên 127.0.0.1 của VPS (đổi nếu 8080 đã có dịch vụ khác)
API_PORT=8080

# --- Ứng dụng ---
ASPNETCORE_ENVIRONMENT=Production
# Khoá JWT mới, ≥ 32 ký tự ngẫu nhiên
Jwt__SecretKey=
# Admin tạo khi khởi động lần đầu
SeedAdmin__Email=admin@staymaster.vn
SeedAdmin__Password=
# Domain frontend trên Vercel
App__FrontendUrl=https://staymaster-frontend.vercel.app
App__CorsOrigins__0=https://staymaster-frontend.vercel.app
App__SupportEmail=support@staymaster.vn
App__SupportPhone=1900 0000

# SePay: API key mới + tài khoản nhận tiền. Webhook SePay: https://<API_DOMAIN>/api/payment/sepay-webhook
SePay__ApiKey=
SePay__BankId=
SePay__AccountNumber=
SePay__AccountName=

# Chatbot
Ai__Provider=deepseek
Ai__Model=deepseek-flash
Ai__ApiKey=
Ai__TimeoutSeconds=5
